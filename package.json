{
  "name": "circuit-design-harness",
  "version": "0.3.0",
  "private": true,
  "author": "Circuit Design Harness contributors",
  "description": "An AI-assisted electronics design and physical-build workbench powered by Pi.",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.2.17",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "catalog:sync-esphome": "node scripts/sync-esphome-catalog.mjs",
    "simulators:build": "node scripts/build-local-simulators.mjs",
    "voice:build": "node scripts/build-local-voice.mjs",
    "test:e2e": "bun run build && playwright test",
    "package:dir": "bun run build && electron-builder --mac dir --publish never --config.mac.identity=null --config.mac.hardenedRuntime=false",
    "package:mac": "bun run build && MAC_RELEASE_SIGN=1 electron-builder --mac --publish never",
    "package:mac:verify": "bash scripts/verify-macos-gatekeeper.sh \"release/mac-arm64/Circuit Design Harness.app\"",
    "quality": "bun run check && bun run typecheck && bun run test && bun run storage:check && bun run build",
    "storage:check": "node scripts/check-storage-policy.mjs",
    "arduino:setup": "bash scripts/setup-arduino-cli.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "selfsigned": "^5.5.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.7",
    "ws": "^8.21.3",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.58.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.pi.circuit-design-harness",
    "productName": "Circuit Design Harness",
    "afterPack": "build/macos-after-pack.cjs",
    "electronLanguages": [
      "en"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/@earendil-works/pi-tui/native/win32/**",
      "!**/node_modules/@earendil-works/pi-tui/native/darwin/prebuilds/darwin-x64/**",
      "!**/node_modules/@earendil-works/pi-tui/native/**/build.sh",
      "!**/node_modules/@earendil-works/pi-tui/native/**/build.mjs",
      "!**/node_modules/@earendil-works/pi-tui/native/**/src/**",
      "!**/node_modules/@earendil-works/pi-tui/native/**/*.c",
      "!**/node_modules/@earendil-works/pi-tui/native/**/*.md"
    ],
    "extraResources": [
      {
        "from": "simulator/dist",
        "to": "simulators",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "voice/dist",
        "to": "voice",
        "filter": [
          "**/*",
          "!**/models/**"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "chatterbox-speak.py",
          "wakeword-detect.py"
        ]
      },
      {
        "from": "voice/sources.json",
        "to": "voice-sources.json"
      },
      {
        "from": "voice/wakeword",
        "to": "wakeword",
        "filter": [
          "hey_livekit.onnx"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Circuit Design Harness uses a camera only when you start a visual build review.",
        "NSMicrophoneUsageDescription": "Circuit Design Harness uses the microphone for push-to-talk and, only when you explicitly enable it, local Eve wake-word listening."
      }
    }
  }
}
